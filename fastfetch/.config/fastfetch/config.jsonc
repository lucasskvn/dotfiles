{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": "  ",
    "color": {
      "keys": "blue",
      "symbols": "yellow",
      "title": "green"
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "title": "green"
      }
    },
    "separator",
    {
      "type": "os",
      "key": "OS",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "blue"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "blue"
    },
    {
      "type": "memory",
      "key": "RAM",
      "keyColor": "blue"
    },
    {
      "type": "disk",
      "key": "Disk",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "Term",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "Pkgs",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "blue"
    },
    "separator",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 0,
      "symbolSpacing": 1
    }
  ]
}
